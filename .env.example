# ─────────────────────────────────────────────────────────────
# Solar Market Intelligence MVP — environment template
# Copy to .env and fill in. .env is gitignored.
# ─────────────────────────────────────────────────────────────

# Neon Postgres (dev branch). App runtime uses the POOLED url; migrations/seed use the DIRECT url.
DATABASE_URL="postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DATABASE_DIRECT_URL="postgres://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Better Auth (lives in apps/web). issuer/audience are pinned to this value.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"

# NestJS verifies Better Auth JWTs against this base url's JWKS (/api/auth/jwks).
# MUST equal BETTER_AUTH_URL exactly (scheme, host, no trailing slash) or verification fails.
AUTH_BASE_URL="http://localhost:3000"

# apps/web BFF proxy target (NestJS api).
API_BASE_URL="http://localhost:4000"

# data.go.kr (KPX: 전력수급/발전량/SMP/REC) — already approved.
DATA_GO_KR_API_KEY=""

# 기상청 (KMA: 단기예보/일사량) — already approved.
KMA_API_KEY=""

# Ingestion polling cadence (cron). Conservative due to dev-account ~100 calls/day cap.
INGEST_SUPPLY_CRON="0,30 6-22 * * *"
