    "@solar/db": "workspace:*",
    "@solar/worker": "workspace:*",
    "drizzle-orm": "0.45.1",
    "jose": "6.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.8",
    "@types/express": "5.0.3",
    "@types/node": "24.7.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
